{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src",
    "test": "cross-env NODE_ENV=test jest --testPathIgnorePatterns=tests/integration",
    "test:integration": "dotenv -e .env.test -- cross-env NODE_ENV=test jest --runInBand tests/integration",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --testPathIgnorePatterns=tests/integration --collectCoverageFrom='src/**/*.js'",
    "test:integration:coverage": "dotenv -e .env.test -- cross-env NODE_ENV=test jest --runInBand --coverage tests/integration --collectCoverageFrom='src/**/*.js'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "docker:test:up": "cd .. && docker-compose up -d && node -e \"setTimeout(() => console.log('✅ Base de datos lista'), 5000)\"",
    "docker:test:down": "cd .. && docker-compose down",
    "db:test:push": "dotenv -e .env.test -- prisma db push --accept-data-loss",
    "test:integration:all": "npm run docker:test:up && npm run db:test:push && npm run test:integration && npm run docker:test:down",
    "test:integration:allcoverage": "npm run docker:test:up && npm run db:test:push && npm run test:integration:coverage && npm run docker:test:down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}
